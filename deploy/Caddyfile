:80 {
    encode zstd gzip

    @backend path /api/* /health/* /docs* /openapi.json
    handle @backend {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy web:3000
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
