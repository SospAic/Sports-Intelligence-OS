# This file is for local development only. Copy it to .env before changing values.
# Production deployments must replace every development-only secret and enable secure cookies.
SIO_ENVIRONMENT=development
SIO_APP_NAME=Content Intelligence OS
SIO_LOG_LEVEL=INFO
SIO_API_HOST=0.0.0.0
SIO_API_PORT=8000

POSTGRES_DB=sports_intelligence
POSTGRES_USER=sio
POSTGRES_PASSWORD=sio-local-development-only
SIO_DATABASE_URL=postgresql+asyncpg://sio:sio-local-development-only@127.0.0.1:5432/sports_intelligence
SIO_DATABASE_POOL_SIZE=10
SIO_DATABASE_MAX_OVERFLOW=20
SIO_DATABASE_POOL_TIMEOUT_SECONDS=30
SIO_DATABASE_POOL_RECYCLE_SECONDS=1800
SIO_DATABASE_COMMAND_TIMEOUT_SECONDS=60
SIO_REDIS_URL=redis://127.0.0.1:6379/0
SIO_REDIS_CONNECT_TIMEOUT_SECONDS=5
SIO_REDIS_SOCKET_TIMEOUT_SECONDS=5
SIO_REDIS_MAX_CONNECTIONS=50
SIO_REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
SIO_REDIS_RETRY_ON_TIMEOUT=true

# Optional live integration. Leave blank until an official YouTube Data API key is provided.
SIO_YOUTUBE_API_KEY=
# Conservative hotspot budget: one daily lane sweep (80 search calls), with room
# left for manual/other API usage. Quota day resets at midnight Pacific Time.
SIO_YOUTUBE_SEARCH_DAILY_BUDGET=80
SIO_YOUTUBE_GENERAL_DAILY_BUDGET=5000
SIO_YOUTUBE_CHART_REFRESH_SECONDS=14400
# Optional official API fallbacks for the local/single-workspace deployment.
# Workspace-level values entered in 设置 → 平台管理 take precedence.
SIO_TIKTOK_CLIENT_KEY=
SIO_TIKTOK_CLIENT_SECRET=
SIO_TIKTOK_ACCESS_TOKEN=
SIO_TIKTOK_REFRESH_TOKEN=
SIO_DOUYIN_CLIENT_KEY=
SIO_DOUYIN_CLIENT_SECRET=
SIO_DOUYIN_ACCESS_TOKEN=
SIO_DOUYIN_REFRESH_TOKEN=
SIO_VIDEO_SEARCH_ENABLED=true
SIO_VIDEO_SEARCH_DEFAULT_INTERVAL_SECONDS=3600
SIO_VIDEO_SEARCH_MAX_CANDIDATES_PER_RUN=20
# none keeps candidates auditable without claiming content matches. Set gemini_video
# only after providing a Google AI Studio key; mock is test-only and rejected in production.
SIO_VIDEO_SEARCH_ANALYZER=none
SIO_VIDEO_SEARCH_REQUEST_TIMEOUT_SECONDS=180
SIO_VIDEO_SEARCH_MAX_UPLOAD_BYTES=100000000
SIO_GEMINI_API_KEY=
SIO_GEMINI_VIDEO_MODEL=gemini-3.6-flash

# ---- 本地语义检索（pgvector + 自托管 embedding；检索链路完全不调用 LLM）----
# 打开后 /api/v1/semantic-search 才会返回向量召回结果；关闭时接口降级为 501。
SIO_SEMANTIC_SEARCH_ENABLED=false
# none = 不生成向量；tei = OpenAI 兼容 /v1/embeddings（HF TEI / vLLM / Infinity）；
# ollama = Ollama 的 /api/embed。
SIO_EMBEDDING_BACKEND=none
SIO_EMBEDDING_BASE_URL=http://embeddings:80
SIO_EMBEDDING_API_KEY=
# BGE-M3：MIT 许可，1024 维，100+ 语言，中英跨语种检索表现优异。
SIO_EMBEDDING_MODEL=BAAI/bge-m3
# 必须与模型输出维度一致，且与迁移里建的 vector(N) 列一致；改动需重建索引并回填。
SIO_EMBEDDING_DIMENSION=1024
SIO_EMBEDDING_BATCH_SIZE=16
SIO_EMBEDDING_REQUEST_TIMEOUT_SECONDS=60
SIO_EMBEDDING_CHUNK_CHARS=700
SIO_EMBEDDING_CHUNK_OVERLAP_CHARS=100
SIO_EMBEDDING_MAX_CHUNKS_PER_ITEM=200

# Local subtitle processing is enabled by default in Docker Compose. The
# dedicated subtitle-worker and LibreTranslate service keep this work isolated
# from account monitoring. No estimated/fake text is written when a provider
# is unavailable.
SIO_SUBTITLE_ASR_ENABLED=true
SIO_SUBTITLE_ASR_BACKEND=faster_whisper
SIO_SUBTITLE_ASR_MODEL=small
SIO_SUBTITLE_ASR_DEVICE=auto
SIO_SUBTITLE_ASR_COMPUTE_TYPE=int8
SIO_SUBTITLE_ASR_MODEL_DIR=/workspace/models/whisper
SIO_SUBTITLE_ASR_MAX_FILE_BYTES=4000000000
SIO_SUBTITLE_ASR_MAX_DURATION_SECONDS=7200
SIO_SUBTITLE_ASR_BEAM_SIZE=5
# http expects a local LibreTranslate-compatible or SIO translation service.
SIO_SUBTITLE_TRANSLATION_BACKEND=http
SIO_SUBTITLE_TRANSLATION_BASE_URL=http://translation:5000
SIO_SUBTITLE_TRANSLATION_API_KEY=
SIO_SUBTITLE_TRANSLATION_TIMEOUT_SECONDS=120
SIO_SUBTITLE_TRANSLATION_MAX_SEGMENTS=2000
# Production should keep this as a reviewed immutable digest. The default is
# the multi-platform LibreTranslate v1.9.6 index digest used by Compose.
SIO_TRANSLATION_IMAGE=libretranslate/libretranslate@sha256:1de2d7056bb8ad607a412f4563d9abe324ff632b43b5be9428bcc8e213aebb32

SIO_PLATFORM_REQUEST_TIMEOUT_SECONDS=10
SIO_PLATFORM_REQUEST_MAX_ATTEMPTS=3
SIO_PLATFORM_CANARY_ENABLED=true
SIO_PLATFORM_CANARY_INTERVAL_SECONDS=3600
SIO_SYNC_TASK_MAX_RETRIES=3
SIO_TASK_STALE_AFTER_SECONDS=2100
SIO_SYNC_PAGE_LIMIT=20
SIO_MEDIA_STORAGE_QUOTA_BYTES=
SIO_MEDIA_STORAGE_SCAN_MAX_FILES=100000
# YouTube extraction runtime. Docker ships Node.js 22 and yt-dlp[default]
# (including the matching EJS package). Override only when using a host path.
# Leave blank for local PATH discovery; Docker Compose supplies /usr/local/bin/node.
SIO_YTDLP_NODE_PATH=
SIO_YTDLP_REMOTE_COMPONENTS=
SIO_YTDLP_ALLOW_RUNTIME_UPDATE=false
# Docker-contained headed Chromium for manual platform login. The browser
# service is private to Compose; only its local noVNC view is exposed on 6080.
SIO_BROWSER_CDP_ENDPOINT=http://browser:9222
SIO_BROWSER_VNC_URL=http://localhost:6080/vnc.html?autoconnect=1&resize=scale
SIO_BROWSER_CDP_PORT=9222
SIO_BROWSER_CHROME_CDP_PORT=9223
SIO_BROWSER_CDP_PUBLIC_HOST=browser
SIO_BROWSER_VNC_PORT=6080
SIO_BROWSER_DISPLAY=:99
# SSRF DNS resolution check for news sources. Disable in Docker/dev where DNS may
# resolve external hosts to non-global ranges (e.g. 198.18.x.x benchmark addresses).
SIO_NEWS_SSRF_CHECK_ENABLED=true

# Optional OpenAI-compatible LLM backend. The key is read only by API/Worker processes.
# Mock LLM remains available for clearly labelled development/test output without a key.
SIO_LLM_OPENAI_COMPATIBLE_BASE_URL=
SIO_LLM_OPENAI_COMPATIBLE_API_KEY=
SIO_LLM_DEFAULT_MODEL=gpt-5.6-terra
SIO_LLM_DEFAULT_TEMPERATURE=0.4
SIO_LLM_DEFAULT_TOP_P=1.0
SIO_LLM_DEFAULT_MAX_TOKENS=4096
SIO_LLM_REQUEST_TIMEOUT_SECONDS=60
SIO_LLM_REQUEST_MAX_ATTEMPTS=3

# ─── LLM Gateway (New API) ────────────────────────────────────────────
# Enable with: docker compose --profile llm up -d
SIO_LLM_GATEWAY_SESSION_SECRET=
SIO_LLM_GATEWAY_ROOT_TOKEN=
# Allowlisted internal hosts that bypass SSRF for LLM base URLs
SIO_LLM_INTERNAL_HOSTS_ALLOWLIST='["llm-gateway","llm-experimental","host.docker.internal"]'

# ─── Browser-First Mode ───────────────────────────────────────────────
# When enabled, platform sync prefers Playwright browser adapters over
# official API adapters to save API quota and costs. The browser adapter
# is used regardless of credential mode unless mode is explicitly "api"
# with valid credentials AND browser_first_mode is false.
# Requires Playwright browsers installed in the API/Worker containers.
SIO_BROWSER_FIRST_MODE=false

# ─── LLM Fallback (gpt4free / experimental) ──────────────────────────
# Optional OpenAI-compatible base URL used as an automatic fallback when
# the primary LLM provider fails with rate-limit or authentication errors.
# Typically points to the llm-experimental (gpt4free) Docker service.
# Enable the service with: docker compose --profile llm-experimental up -d
# Example for Docker Compose internal networking:
#   SIO_LLM_FALLBACK_BASE_URL=http://llm-experimental:8000/v1
# Leave blank to disable the fallback chain.
SIO_LLM_FALLBACK_BASE_URL=

# Notification channel credentials are encrypted at rest. Production requires a unique
# key of at least 32 characters; development falls back to SIO_SECRET_KEY when blank.
SIO_NOTIFICATION_ENCRYPTION_KEY=
SIO_NOTIFICATION_REQUEST_TIMEOUT_SECONDS=10
SIO_NOTIFICATION_REQUEST_MAX_ATTEMPTS=3

# Media lifecycle governance. Health and preview are read-only by default;
# physical cleanup requires both ENABLED=true and DRY_RUN=false plus an
# explicit owner/admin confirmation through the API.
SIO_MEDIA_STORAGE_QUOTA_BYTES=
SIO_MEDIA_STORAGE_SCAN_MAX_FILES=100000
SIO_MEDIA_LIFECYCLE_ENABLED=false
SIO_MEDIA_LIFECYCLE_DRY_RUN=true
SIO_MEDIA_RETENTION_DAYS=30
SIO_MEDIA_ORPHAN_RETENTION_DAYS=7
SIO_MEDIA_LIFECYCLE_BATCH_SIZE=200

# Development-only signing/encryption seed. Production validation rejects this value.
SIO_SECRET_KEY=local-development-secret-replace-before-production-2026
SIO_SESSION_COOKIE_NAME=sio_session
SIO_SESSION_COOKIE_SECURE=false
SIO_SESSION_TTL_SECONDS=86400
SIO_AUTH_LOGIN_WINDOW_SECONDS=900
SIO_AUTH_LOGIN_MAX_ATTEMPTS_PER_IDENTITY=10
SIO_AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=100
SIO_AUTH_ATTEMPT_RETENTION_SECONDS=604800
SIO_SESSION_CLEANUP_RETENTION_SECONDS=604800
SIO_PASSWORD_MIN_LENGTH=12
SIO_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# No administrator password is provided by default. Set both values before `make seed`.
SIO_BOOTSTRAP_ADMIN_EMAIL=
SIO_BOOTSTRAP_ADMIN_PASSWORD=
SIO_BOOTSTRAP_WORKSPACE_NAME=Content Intelligence OS

NEXT_PUBLIC_APP_NAME=Content Intelligence OS
API_INTERNAL_URL=http://127.0.0.1:8000
